{
	"manifest_version": 3,
	"name": "PrimAssist",
	"version": "1.0.1",
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_title": "PrimAssist",
		"default_popup": "popup/popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png"
		}
	},
	"permissions": ["storage"],
	"host_permissions": [
		"https://mau.hr.evry.se/*",
		"https://mau.hrpayroll.se/*",
		"http://localhost:4007/*",
		"http://localhost/*",
		"https://mlt.k14net.org/*",
		"https://mlt.k14net.org/health"
	],
	"content_scripts": [
		{
			"matches": ["https://mau.hrpayroll.se/primula*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"web_accessible_resources": [
		{
			"resources": ["icons/*.png"],
			"matches": ["https://mau.hrpayroll.se/primula*"]
		}
	]
}
